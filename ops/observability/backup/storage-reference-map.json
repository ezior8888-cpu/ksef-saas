        }
      ],
      "notes": "Repository scope requires storage.objects but does not define its deployed schema or physical S3 translation. Logical bucket_id/name are not assumed equal to physical Bucket/Key. v1 rejects every nonempty reference as unknown until a verified physical translation rule is added to the trusted repository map; arbitrary input complete/hash flags cannot supply that rule. Zero declared rows may be internally consistent but never prove an empty database.",
      "runtimeSchemaDefinitionInRepository": false
    }
  ],
  "normalizationContract": {
    "input": "One bounded local JSON; pure validateBackupReferences(bundle, referenceMap). CLI reads only that JSON and this trusted repository map; never reads artifact paths.",
    "reference": "{mappingId,referenceId,source,bucket,key,originalKey,sha256:null|hex,provider?}; referenceId identifies row/member, not object.",
    "scope": "{complete:true,mappingIds:[every map id exactly once],rowCounts:{mappingId:count},unresolvedMappings:0,databaseNames:[postgres,_supabase],bucketBindings:{applicationPrimary,applicationBackups:{mode:shared|dedicated,bucket}}}. Flags/counts remain reported claims; they do not prove a DB extraction.",
    "objectManifest": "{source:application|supabase,runId,complete:true,versioning:Unversioned,objects:[{bucket,key,bytes,sha256,...}]}; both sources once, same runId.",
    "ndjsonAdapter": "S3 exporter objects.ndjson uses compatible object records. A separate bounded offline adapter and integrity review must supply objects[]; export-summary/path is not followed or accepted as objects[], nor as recovery/configuration completeness.",
    "nulls": "Only nullable mappings accept key/originalKey/bucket/sha256 all null. No implicit undefined-to-null. Hash-required mappings reject null SHA-256. Optional absent hashes are counted, not verified.",
    "backupPrefix": "Use reported bucketBindings; shared uses exactly backups/ + originalKey, dedicated uses exactly originalKey. No inferred endpoint/configuration.",
    "supabaseTranslation": "v1 has no verified physical translation rule in the trusted map, so EVERY nonempty storage.objects reference is unknown even when input supplies complete:true/evidenceSha256 or an exported matching object. Extend the trusted versioned map/checker only after the schema/backend mapping is verified. Do not use arbitrary normalization flags as a rule."
  },
  "gaps": [
