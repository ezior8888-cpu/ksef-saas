# Build context = tylko to, czego potrzebuje `next build`.
# Mniejszy context = szybszy upload do daemona i mniej cache-missów.
node_modules
.next
.git
.claude
.vscode

# Lokalne pliki operatora i agentów — root oraz zagnieżdżone katalogi.
# .gitignore nie chroni kontekstu wysyłanego przez lokalny docker build.
**/.agents
**/.codex
**/.mcp.json
**/.tmp

# Testy i narzędzia deweloperskie — nie wchodzą do obrazu.
e2e
tests
load-tests
playwright-report
test-results
playwright.config.ts
vitest.config.ts
# Importuje vitest.config.ts, którego tu nie ma — `next build` sprawdza typy
# każdego *.ts w kontekście i wywracał build obrazu (wdrożenie 36, 25.09).
vitest.rls.config.ts

# Dokumentacja i materiały wewnętrzne.
docs
*.md
!README.md

# Migracje wgrywane osobno (pnpm db:push:prod), nie z kontenera.
supabase

# Lokalne środowisko — root i podkatalogi; env dostarcza Coolify.
**/.[eE][nN][vV]*
**/.[nN][pP][mM][rR][cC]
**/faktflow-backup.env
instrukcja.txt
ai_todo.md

# Poświadczenia plikowe są tylko dev/test; produkcja odczytuje je z DB/API.
# Brak wymaganych certyfikatów plikowych w repo. Nowy publiczny CA wymaga
# osobnej, sprawdzonej reguły dla konkretnej ścieżki, nie ogólnego wyjątku.
**/.ksef-test-certs
**/*.[pP][eE][mM]
**/*.[kK][eE][yY]
**/*.[cC][rR][tT]
**/*.[cC][eE][rR]
**/*.[pP]12
**/*.[pP][fF][xX]

# Kopie danych i ich artefakty; nie wykluczamy źródeł lib/backup ani *.sql.
**/backups
**/.outbox
**/backup_*.[sS][qQ][lL]
**/backup_*.[sS][qQ][lL].*
**/*.[dD][uU][mM][pP]
**/*.[dD][uU][mM][pP].*
**/*.roles.[sS][qQ][lL]
**/*.roles.[sS][qQ][lL].*

